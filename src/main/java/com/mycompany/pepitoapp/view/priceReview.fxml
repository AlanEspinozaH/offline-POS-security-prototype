<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pepitoapp.controller.PriceReviewController" stylesheets="@purchase-pricing.css">
  <top><HBox spacing="15" styleClass="header"><Label text="REVISIÓN DE PRECIOS" styleClass="title"/><Pane HBox.hgrow="ALWAYS"/><Button text="Actualizar" onAction="#refresh"/></HBox></top>
  <center><SplitPane dividerPositions="0.62"><TableView fx:id="table"><columns><TableColumn fx:id="productColumn" text="Producto" prefWidth="220"/><TableColumn fx:id="priceColumn" text="Precio" prefWidth="75"/><TableColumn fx:id="costColumn" text="Últ. costo" prefWidth="105"/><TableColumn fx:id="marginColumn" text="Margen" prefWidth="80"/><TableColumn fx:id="variationColumn" text="Variación" prefWidth="85"/><TableColumn fx:id="statusColumn" text="Estado" prefWidth="95"/></columns></TableView>
    <ScrollPane fitToWidth="true"><VBox spacing="12"><padding><Insets top="18" right="18" bottom="18" left="18"/></padding><Label text="Detalle y decisión administrativa" styleClass="section-title"/><GridPane hgap="12" vgap="9"><columnConstraints><ColumnConstraints minWidth="185"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
      <Label text="Precio actual"/><Label fx:id="currentPriceLabel" GridPane.columnIndex="1"/><Label text="Costo anterior" GridPane.rowIndex="1"/><Label fx:id="previousCostLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Último costo" GridPane.rowIndex="2"/><Label fx:id="latestCostLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Label text="Promedio histórico ponderado" GridPane.rowIndex="3"/><Label fx:id="averageCostLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/><Label text="Margen bruto" GridPane.rowIndex="4"/><Label fx:id="marginLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/><Label text="Precio matemático" GridPane.rowIndex="5"/><Label fx:id="theoreticalLabel" GridPane.columnIndex="1" GridPane.rowIndex="5"/><Label text="Sugerencia comercial" GridPane.rowIndex="6"/><Label fx:id="suggestedLabel" GridPane.columnIndex="1" GridPane.rowIndex="6"/><Label text="Estabilidad" GridPane.rowIndex="7"/><Label fx:id="protectedLabel" GridPane.columnIndex="1" GridPane.rowIndex="7" wrapText="true"/></GridPane>
      <Separator/><Label text="Programar cambio" styleClass="section-title"/><TextField fx:id="newPriceField" promptText="Nuevo precio (múltiplo de S/ 0.10)"/><DatePicker fx:id="effectiveDatePicker" promptText="Aplicar desde"/><TextField fx:id="reasonField" promptText="Motivo"/><Button text="PROGRAMAR CAMBIO" onAction="#schedulePrice" styleClass="primary" maxWidth="Infinity"/>
      <Separator/><Label text="Política de margen y estabilidad" styleClass="section-title"/><HBox spacing="8"><TextField fx:id="targetMarginField" promptText="Margen objetivo %" HBox.hgrow="ALWAYS"/><TextField fx:id="minimumMarginField" promptText="Margen mínimo %" HBox.hgrow="ALWAYS"/></HBox><DatePicker fx:id="lockedUntilPicker" promptText="No revisar antes de"/><Button text="Guardar política" onAction="#savePolicy"/><Label fx:id="feedbackLabel" wrapText="true"/>
    </VBox></ScrollPane></SplitPane></center>
</BorderPane>
